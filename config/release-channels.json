{
  "$schema": "../contracts/json-schema/release-channels.schema.json",
  "product": "Ross Tax Pro Software Co Enterprise Tax Platform",
  "majorMinor": "2.0",
  "defaultChannel": "alpha",
  "channels": [
    {
      "id": "dev",
      "tag": "v2.0-dev",
      "semanticVersion": "2.0.0-dev.0",
      "displayName": "Developer Build",
      "description": "Continuously integrated developer build for internal engineering and automated validation.",
      "stability": 10,
      "audience": ["engineering", "qa"],
      "deploymentEnvironment": "development",
      "sourceBranches": ["develop", "feature/*"],
      "prerelease": true,
      "supportPolicy": "best-effort",
      "promotionTargets": ["alpha", "hotfix"]
    },
    {
      "id": "alpha",
      "tag": "v2.0-alpha",
      "semanticVersion": "2.0.0-alpha.0",
      "displayName": "Alpha Build",
      "description": "Early unstable integration build used to prove architecture, routes, contracts, and deployment mechanics.",
      "stability": 20,
      "audience": ["engineering", "qa", "approved-pilot-users"],
      "deploymentEnvironment": "alpha",
      "sourceBranches": ["develop", "release/v2.0-alpha"],
      "prerelease": true,
      "supportPolicy": "engineering-only",
      "promotionTargets": ["beta", "hotfix"]
    },
    {
      "id": "beta",
      "tag": "v2.0-beta",
      "semanticVersion": "2.0.0-beta.0",
      "displayName": "Beta Build",
      "description": "Feature-complete validation build; production acceptance, security, accessibility, and performance gates may still be open.",
      "stability": 40,
      "audience": ["qa", "operations", "approved-beta-users"],
      "deploymentEnvironment": "beta",
      "sourceBranches": ["release/v2.0-beta"],
      "prerelease": true,
      "supportPolicy": "limited",
      "promotionTargets": ["rc1", "hotfix"]
    },
    {
      "id": "rc1",
      "tag": "v2.0-rc1",
      "semanticVersion": "2.0.0-rc.1",
      "displayName": "Release Candidate 1",
      "description": "Release candidate frozen for final production-readiness review and controlled acceptance testing.",
      "stability": 70,
      "audience": ["qa", "security", "compliance", "release-management"],
      "deploymentEnvironment": "staging",
      "sourceBranches": ["release/v2.0-rc1"],
      "prerelease": true,
      "supportPolicy": "release-candidate",
      "promotionTargets": ["stable", "hotfix"]
    },
    {
      "id": "stable",
      "tag": "v2.0-stable",
      "semanticVersion": "2.0.0",
      "displayName": "Stable Production Build",
      "description": "Final generally available production release after mandatory acceptance gates pass.",
      "stability": 90,
      "audience": ["production-users", "partners", "operations"],
      "deploymentEnvironment": "production",
      "sourceBranches": ["main", "release/v2.0-stable"],
      "prerelease": false,
      "supportPolicy": "standard",
      "promotionTargets": ["lts", "enterprise", "hotfix"]
    },
    {
      "id": "lts",
      "tag": "v2.0-lts",
      "semanticVersion": "2.0.0-lts.0",
      "displayName": "Long-Term Support Build",
      "description": "Stabilized production branch receiving security, compliance, and critical reliability maintenance for an extended support window.",
      "stability": 95,
      "audience": ["long-term-support-customers", "regulated-operations"],
      "deploymentEnvironment": "production-lts",
      "sourceBranches": ["lts/v2.0"],
      "prerelease": false,
      "supportPolicy": "long-term-support",
      "promotionTargets": ["enterprise", "hotfix"]
    },
    {
      "id": "enterprise",
      "tag": "v2.0-enterprise",
      "semanticVersion": "2.0.0-enterprise.0",
      "displayName": "Enterprise Build",
      "description": "Enterprise-grade distribution with hardened governance, tenant controls, observability, deployment evidence, and controlled integration profiles.",
      "stability": 100,
      "audience": ["enterprise-customers", "administrators", "auditors"],
      "deploymentEnvironment": "production-enterprise",
      "sourceBranches": ["enterprise/v2.0"],
      "prerelease": false,
      "supportPolicy": "enterprise",
      "promotionTargets": ["hotfix"]
    },
    {
      "id": "hotfix",
      "tag": "v2.0-hotfix",
      "semanticVersion": "2.0.0-hotfix.0",
      "displayName": "Emergency Hotfix Build",
      "description": "Controlled emergency patch lane requiring incident linkage, narrowly scoped changes, accelerated validation, and post-release reconciliation.",
      "stability": 80,
      "audience": ["incident-command", "security", "release-management"],
      "deploymentEnvironment": "production-hotfix",
      "sourceBranches": ["hotfix/v2.0-*"],
      "prerelease": false,
      "supportPolicy": "incident-response",
      "promotionTargets": ["stable", "lts", "enterprise"]
    }
  ]
}
