{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosstaxsoftware.com/schemas/release-channels.schema.json",
  "title": "RTPSC Release Channel Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "majorMinor", "defaultChannel", "channels"],
  "properties": {
    "$schema": { "type": "string" },
    "product": { "type": "string", "minLength": 3 },
    "majorMinor": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "defaultChannel": {
      "type": "string",
      "enum": ["dev", "alpha", "beta", "rc1", "stable", "lts", "enterprise", "hotfix"]
    },
    "channels": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/channel" }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "semanticVersion",
        "displayName",
        "description",
        "stability",
        "audience",
        "deploymentEnvironment",
        "sourceBranches",
        "prerelease",
        "supportPolicy",
        "promotionTargets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["dev", "alpha", "beta", "rc1", "stable", "lts", "enterprise", "hotfix"]
        },
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+-(dev|alpha|beta|rc1|stable|lts|enterprise|hotfix)$"
        },
        "semanticVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "displayName": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 20 },
        "stability": { "type": "integer", "minimum": 0, "maximum": 100 },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "deploymentEnvironment": { "type": "string", "minLength": 2 },
        "sourceBranches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prerelease": { "type": "boolean" },
        "supportPolicy": { "type": "string", "minLength": 2 },
        "promotionTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["dev", "alpha", "beta", "rc1", "stable", "lts", "enterprise", "hotfix"]
          }
        }
      }
    }
  }
}
