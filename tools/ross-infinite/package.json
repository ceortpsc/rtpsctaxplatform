{
  "name": "@rtp/ross-infinite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ROSS.CO Infinite production-candidate package manager, task graph, registry, transfer engine, MCP, and SEO ownership platform",
