{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ross.co/schemas/seo-ownership.schema.json",
  "title": "ROSS.CO SEO Ownership Configuration",
  "type": "object",
  "required": ["version", "owner", "brand", "properties", "verification", "output"],
  "properties": {
    "version": { "type": "string" },
    "product": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["legalName", "ownerAssertion", "ownerName", "assertedAt"],
      "properties": {
        "legalName": { "type": "string", "minLength": 1 },
        "ownerAssertion": { "type": "boolean" },
        "ownerName": { "type": "string", "minLength": 1 },
        "assertedAt": { "type": "string" },
        "contactEmail": { "type": "string" },
        "organization": { "type": "string" }
      }
    },
    "brand": {
      "type": "object",
      "required": ["name", "title", "description", "canonical"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tagline": { "type": "string" },
        "canonical": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["host", "url", "propertyType"],
        "properties": {
          "host": { "type": "string" },
          "url": { "type": "string" },
          "propertyType": { "enum": ["domain", "url-prefix"] },
          "role": { "type": "string" },
          "primary": { "type": "boolean" }
        }
      }
    },
    "verification": { "type": "object" },
    "output": {
      "type": "object",
      "required": ["publicDir", "evidenceDir"],
      "properties": {
        "publicDir": { "type": "string" },
        "evidenceDir": { "type": "string" }
      }
    },
    "evidenceStates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
