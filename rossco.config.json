{
  "$schema": "./tools/rossco/rossco.config.schema.json",
  "brand": {
    "name": "ROSS.CO",
    "expansion": "Infinite Transfer Rate Package Manager",
    "tagline": "Transfer without ceiling.",
    "domain": "ross.co",
    "mark": "◈"
  },
  "transfer": {
    "mode": "infinite",
    "parallel": true,
    "delegateLinker": "aol"
