  },
  "presence": {
    "siteRoot": "presence/rossco",
    "seo": {
      "title": "ROSS.CO — Infinite Transfer Rate Package Manager",
      "description": "ROSS.CO ITR is the RTPSC package-velocity lifecycle suite: map, plan, scope, stage, test, validate, verify, register, and publish.",
      "canonical": "https://ross.co/"
    }
  },
  "copyright": {
    "holder": "RTPSC / Ross Tax Software",
    "year": 2026,
    "spdx": "MIT"
  }
}
