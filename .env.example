# Ross Tax Pro Software Co | RunTime AI Assist
ROSS_HOST=127.0.0.1
ROSS_PORT=8787
ROSS_ENV=local
ROSS_LOG_LEVEL=info
# Public site URL for canonical SEO (set behind tunnels / production)
# ROSS_PUBLIC_URL=https://your-domain.example
# ROSS_GITHUB_CLIENT_ID=
# ROSS_GITHUB_CLIENT_SECRET=
# ROSS_GITHUB_REDIRECT_URI=http://127.0.0.1:8787/auth/github/callback
# ROSS_SMTP_HOST=smtp.example.com
# ROSS_SMTP_PORT=587
# ROSS_SMTP_USER=
# ROSS_SMTP_PASS=
# ROSS_SMTP_FROM=noreply@rosstaxsoftware.com
# ROSS_SMTP_TLS=1
# RTPSC Tax Platform — root env template
# Copy to .env for local use. Never commit real secrets or private keys.
# Cursor Cloud: set the same keys as Personal environment secrets (not in git).

APP_ENV=local
NODE_ENV=development
SERVICE_PORT=3000

# Existing platform client placeholders
API_CLIENT_ID=local-api-client-id
API_CLIENT_SECRET=replace-in-local-secret-store
TDS_CLIENT_ID=local-tds-client-id
TDS_CLIENT_SECRET=replace-in-local-secret-store
TUNNEL_CLIENT_ID=local-tunnel-client-id
TUNNEL_CLIENT_SECRET=replace-in-local-secret-store
APPROVED_TUNNEL_ENDPOINT=https://api.irs.gov/oauth2/v1/token
APPROVED_TUNNEL_ENDPOINT_SECONDARY=https://api.irs.gov/
TUNNEL_REQUIRE_HTTPS=true
ERO_PTIN=
ERO_CAF_NUMBER=
EFIN=
ETIN=
EFILE_TRANSMISSION_ENABLED=false

# Firm / operator identity (operational seed — no demo clients)
FIRM_LEGAL_NAME=Ross Tax Pro Software Co
FIRM_APPLICATION=Efile Transmission Software
FIRM_EMAIL=
OPERATOR_NAME=
OPERATOR_EMAIL=
FIRM_ADDRESS_LINE1=
FIRM_CITY=
FIRM_STATE=
FIRM_POSTAL=
FIRM_PHONE=
POS_REGISTER_ID=REG-RTPSC-1
POS_CASHIER_ID=

# Service wiring (optional URL overrides; defaults come from secure-tunnel topology)
# API_GATEWAY_URL=http://127.0.0.1:3000
# REFUND_STATUS_URL=http://127.0.0.1:3001
# TRANSCRIPT_SERVICE_URL=http://127.0.0.1:3002
# ANALYTICS_SERVICE_URL=http://127.0.0.1:3003
# ENROLLMENT_SERVICE_URL=http://127.0.0.1:3004
# INVOICE_SERVICE_URL=http://127.0.0.1:3005
# POS_CRM_SERVICE_URL=http://127.0.0.1:3006
# MODULES_DASHBOARD_URL=http://127.0.0.1:3010
# ROSS_AI_URL=http://127.0.0.1:8787
# IRS_GATEWAY_URL=http://127.0.0.1:8820
# AI_WORKFORCE_URL=http://127.0.0.1:8860
# APPLE_CONSOLE_URL=http://127.0.0.1:8870

# IRS OAuth2 / TDS (primary)
IRS_TOKEN_URL=https://api.irs.gov/oauth2/v1/token
IRS_SCOPE=tds
IRS_CLIENT_ID=replace-via-cursor-or-secret-store
IRS_KEY_ID=replace-via-cursor-or-secret-store
IRS_PRIVATE_KEY_PATH=./certs/irs_tds_private.key
IRS_CLIENT_ID_PRIMARY=replace-via-cursor-or-secret-store
IRS_CLIENT_SECRET_PRIMARY=replace-via-cursor-or-secret-store
IRS_PRIVATE_KEY_PATH_PRIMARY=./certs/irs_tds_private.key
IRS_KEY_ID_PRIMARY=replace-via-cursor-or-secret-store

# IRS OAuth2 / TDS (secondary / failover)
IRS_CLIENT_ID_SECONDARY=replace-via-cursor-or-secret-store
IRS_CLIENT_SECRET_SECONDARY=replace-via-cursor-or-secret-store
IRS_PRIVATE_KEY_PATH_SECONDARY=./certs/irs_tds_private_secondary.key
IRS_KEY_ID_SECONDARY=replace-via-cursor-or-secret-store

# Optional application secrets
SBTPG_CLIENT_ID=replace-via-cursor-or-secret-store
SBTPG_CLIENT_SECRET=replace-via-cursor-or-secret-store
JWT_SECRET=replace-via-cursor-or-secret-store
SESSION_SECRET=replace-via-cursor-or-secret-store
ENCRYPTION_KEY=replace-via-cursor-or-secret-store

# Apple Developer / App Store Connect API (never commit real .p8 keys)
APPLE_CONNECT_ENABLED=false
APPLE_ASC_ISSUER_ID=replace-via-cursor-or-secret-store
APPLE_ASC_KEY_ID=replace-via-cursor-or-secret-store
APPLE_ASC_PRIVATE_KEY_PATH=./certs/AuthKey_ASC.p8
APPLE_ASC_PRIVATE_KEY_PEM=
APPLE_TEAM_ID=replace-via-cursor-or-secret-store
APPLE_BUNDLE_ID=com.rosstaxsoftware.rtpsc
APPLE_ASC_TOKEN_TTL=1200
APPLE_RETURN_FULL_TOKEN=false
