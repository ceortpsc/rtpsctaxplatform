{
  "program": "RTPSC Identity, Employee Account & Credential Governance",
  "version": "2.0.0",
  "principles": [
    "Default deny",
    "Least privilege",
    "Need-to-know",
    "Tenant isolation",
    "Separation of duties",
    "No plaintext passwords or recovery secrets",
    "No silent privilege escalation",
    "Non-destructive compliance records"
  ],
  "account_lifecycle": [
    "employee_record_created",
    "account_requested",
    "manager_or_admin_review",
    "role_approved",
    "username_reserved",
    "invitation_issued",
    "password_set_by_employee",
    "mfa_enrolled",
    "account_activated",
    "periodic_access_review",
    "suspend_or_lock",
    "terminate_and_revoke"
  ],
  "username": {
    "rules": [
      "Unique within workspace",
      "6-64 characters",
      "Lowercase normalized",
      "Starts with a letter",
      "Allowed characters: letters, numbers, dot, underscore, hyphen",
      "Immutable after activation unless an audited username-change workflow is approved"
    ]
  },
  "password": {
    "minimum_length": 15,
    "maximum_length": 128,
    "storage": "memory-resistant password hash only",
    "plaintext_retention": "none",
    "temporary_passwords": "not emailed or stored; use one-time activation/reset links",
    "history": 5,
    "failed_attempt_limit": 5,
    "lockout_minutes": 30,
    "reset_token_minutes": 20,
    "privileged_mfa_required": true,
    "deny_common_or_breached_passwords": true,
    "force_change_after_admin_reset": true
  },
  "employee_account_creation": {
    "required_fields": ["employee_number","first_name","last_name","work_email","job_title","requested_role","manager_or_approver"],
    "approval_rules": [
      "Requester cannot approve their own privileged account",
      "Owner role requires owner approval",
      "Admin/ERO role changes require independent approval",
      "Role assignment must be recorded before activation",
      "MFA must be enrolled before privileged activation"
    ]
  },
  "credential_issuance": {
    "credential_types": ["password","totp","webauthn","recovery_code","api_key"],
    "issuance_events": ["initial","reset","replacement","mfa_enrollment","recovery"],
    "delivery": ["invite_link","identity_provider","in_person","other"],
    "rules": [
      "Credential secrets are never logged",
      "Only hashes/fingerprints are persisted where possible",
      "One-time links expire and become unusable after consumption",
      "Revocation is auditable",
      "Recovery requires identity verification",
      "API keys are service credentials, never employee passwords"
    ]
  },
  "role_codes": ["owner","admin","ero","practitioner","preparer","collector","viewer"],
  "privileged_roles": ["owner","admin","ero"],
  "role_change": {
    "requires_reason": true,
    "requires_audit": true,
    "requires_independent_approval_for_privileged_roles": true,
    "effective_immediately": false,
    "supports_future_effective_date": true
  },
  "termination": {
    "actions": ["disable_account","revoke_sessions","revoke_credentials","revoke_active_roles","preserve_audit_history"],
    "target_time": "immediate_after_authorized_termination_event"
  },
  "access_review": {
    "frequency": "quarterly",
    "privileged_roles": "monthly",
    "trigger_events": ["job_change","manager_change","department_change","leave","security_incident","termination"]
  }
}
