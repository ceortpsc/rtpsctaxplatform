+@app.get("/metrics", response_class=PlainTextResponse)
+async def prometheus_metrics():
+    counts = RUNTIME_STORE.job_counts()
+    body = metrics.prometheus()
+    body += "# HELP ross_runtime_jobs Current durable job counts by status.\n"
+    body += "# TYPE ross_runtime_jobs gauge\n"
+    for status, value in counts.items():
+        body += f'ross_runtime_jobs{{status="{status}"}} {value}\n'
+    body += f"ross_runtime_incidents_open {RUNTIME_STORE.count_open_incidents()}\n"
+    return PlainTextResponse(body, media_type="text/plain; version=0.0.4")
+
