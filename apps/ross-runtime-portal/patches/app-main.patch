+@app.get("/health/ready")
+async def health_ready():
+    database = RUNTIME_STORE.database_health()
+    workers = RUNTIME_STORE.list_workers()
+    if RUNTIME_CONFIG.in_process_workers:
+        worker_ready = bool(workers) and all(
+            item["age_seconds"] <= RUNTIME_CONFIG.stale_worker_seconds for item in workers
+        )
+    else:
+        worker_ready = bool(workers) and any(
+            item["age_seconds"] <= RUNTIME_CONFIG.stale_worker_seconds for item in workers
+        )
+    ready = bool(database["ok"] and worker_ready)
+    return JSONResponse(
+        {
+            "status": "ready" if ready else "not_ready",
+            "database": database,
+            "worker_ready": worker_ready,
+            "workers": workers,
+            "job_counts": RUNTIME_STORE.job_counts(),
+            "open_incidents": RUNTIME_STORE.count_open_incidents(),
+        },
+        status_code=200 if ready else 503,
+    )
+
