+@app.exception_handler(Exception)
+async def unhandled_exception_handler(request: Request, exc: Exception):
+    trace_id = getattr(request.state, "trace_id", secrets.token_hex(16))
+    request_id = getattr(request.state, "request_id", secrets.token_hex(10))
+    incident_id = RUNTIME_STORE.create_incident(
+        "critical",
+        "http.unhandled_exception",
+        f"Unhandled exception on {request.method} {request.url.path}",
+        {"error": repr(exc), "trace_id": trace_id, "request_id": request_id},
+    )
+    logger.exception(
+        "http.unhandled_exception",
+        extra={
+            "trace_id": trace_id,
+            "request_id": request_id,
+            "incident_id": incident_id,
+            "path": request.url.path,
+        },
+    )
+    if request.url.path.startswith("/api/") or request.headers.get("accept", "").startswith("application/json"):
+        return JSONResponse(
+            {
+                "error": "internal_server_error",
+                "message": "The runtime recorded the failure and started recovery handling.",
+                "incident_id": incident_id,
+                "trace_id": trace_id,
+            },
+            status_code=500,
+            headers={"X-Incident-ID": incident_id, "X-Trace-ID": trace_id},
+        )
+    html = f"""<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width'><title>Runtime recovery</title><style>body{{margin:0;background:#050607;color:#edf0f3;font-family:Segoe UI,Arial,sans-serif;display:grid;place-items:center;min-height:100vh}}main{{max-width:720px;padding:38px;border:1px solid #2a313b;border-left:4px solid #f10c22;border-radius:16px;background:#0e1217;box-shadow:0 25px 80px #0008}}h1{{margin-top:0}}code{{color:#ff6874}}a{{color:#fff}}</style></head><body><main><p>ROSS RUNTIME RECOVERY</p><h1>The request could not be completed.</h1><p>The failure was logged, traced, and assigned to the self-healing runtime. Refresh after a moment or review Runtime Operations.</p><p>Incident: <code>{incident_id}</code><br>Trace: <code>{trace_id}</code></p><a href='/runtime-operations'>Open Runtime Operations</a></main></body></html>"""
+    return HTMLResponse(html, status_code=500, headers={"X-Incident-ID": incident_id, "X-Trace-ID": trace_id})
+
