+@app.post("/api/v1/runtime/jobs", status_code=201)
+async def create_runtime_job(payload: RuntimeJobCreateRequest):
+    job = RUNTIME_STORE.enqueue_job(
+        payload.type,
+        payload.queue,
+        payload.payload,
+        max_attempts=payload.max_attempts,
+        delay_seconds=payload.delay_seconds,
+    )
+    return {"data": job}
+
+
+@app.post("/api/v1/runtime/workers/{worker_name}/restart")
+async def restart_runtime_worker(worker_name: str):
+    if not RUNTIME_CONFIG.in_process_workers:
+        raise HTTPException(
+            status_code=409,
+            detail="Workers are managed by an external service in this deployment mode.",
+        )
+    restarted = await RUNTIME_SUPERVISOR.restart_worker(worker_name)
+    if not restarted:
+        raise HTTPException(status_code=404, detail="Worker not found.")
+    return {"data": {"worker": worker_name, "restart_requested": True}}
+
+
