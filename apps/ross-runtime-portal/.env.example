ROSS_RUNTIME_PUBLIC_URL=http://127.0.0.1:8000
ROSS_RUNTIME_ACCESS_CODE=ross-demo
ROSS_RUNTIME_SESSION_SECRET=replace-with-at-least-32-random-characters
ROSS_RUNTIME_HTTPS_ONLY=false
ROSS_RUNTIME_RETENTION_DAYS=0
ROSS_RUNTIME_HOST=127.0.0.1
ROSS_RUNTIME_PORT=8000
ROSS_RUNTIME_RELOAD=true
ROSS_RUNTIME_LOG_LEVEL=INFO
ROSS_RUNTIME_LOG_DIR=logs
ROSS_RUNTIME_REPORT_DIR=reports
ROSS_RUNTIME_IN_PROCESS_WORKERS=true
ROSS_RUNTIME_SCHEDULER_ENABLED=true
ROSS_RUNTIME_WORKER_POLL_SECONDS=0.75
ROSS_RUNTIME_HEARTBEAT_SECONDS=5
ROSS_RUNTIME_STALE_WORKER_SECONDS=25
ROSS_RUNTIME_SCHEDULER_TICK_SECONDS=5
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
