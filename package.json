{
  "name": "rtpsctaxplatform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "aol@0.1.0",
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*",
    "pipelines/*",
    "engines/*",
    "tools/*"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "lint": "./scripts/lint.sh",
    "test": "./scripts/test.sh",
    "build": "./scripts/build.sh",
    "start": "./scripts/start.sh",
    "start:all": "./scripts/start-all.sh",
    "start:all:fg": "node ./scripts/start-all.mjs",
    "start:check": "node ./scripts/start-all.mjs --check-only",
    "start:gateway": "node ./tools/aol/bin/aol.mjs run -w @rtp/api-gateway start",
    "start:irs-gateway": "node ./tools/aol/bin/aol.mjs run -w @rtp/irs-gateway start",
    "start:refund-status": "node ./tools/aol/bin/aol.mjs run -w @rtp/refund-status-service start",
    "start:transcript": "node ./tools/aol/bin/aol.mjs run -w @rtp/transcript-service start",
    "start:analytics": "node ./tools/aol/bin/aol.mjs run -w @rtp/analytics-service start",
    "worker:tds": "node ./tools/aol/bin/aol.mjs run -w @rtp/tds-worker start -- --once",
    "worker:transcript-pull": "node ./tools/aol/bin/aol.mjs run -w @rtp/transcript-pull-worker start -- --once",
    "worker:live-source": "node ./tools/aol/bin/aol.mjs run -w @rtp/live-source-fetcher start -- --once",
    "bench:aol": "node ./tools/aol/bin/aol.mjs bench",
    "aol": "node ./tools/aol/bin/aol.mjs",
    "ross": "python3 ./ross.py",
    "ross:init": "python3 ./ross.py init",
    "ross:doctor": "python3 ./ross.py doctor",
    "ross:dev": "python3 ./ross.py dev",
    "ross:package": "python3 ./ross.py package build",
    "ross:hello": "python3 ./ross.py runtime run hello"
    "compliance": "node ./packages/production-compliance/bin/prodcheck.mjs run",
    "compliance:checklist": "node ./packages/production-compliance/bin/prodcheck.mjs checklist",
    "compliance:report": "node ./packages/production-compliance/bin/prodcheck.mjs report",
    "compliance:log": "node ./packages/production-compliance/bin/prodcheck.mjs log"
  },
  "engines": {
    "node": ">=22"
  }
}
