{
  "name": "rtpsctaxplatform",
  "version": "02.0V",
  "description": "Ross Tax Pro Software Co 02.0V — Efile Transmission Software · hierarchy of enterprise-grade tax pro software",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "bin": {
    "rtpsc": "bin/rtpsc.mjs"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*",
    "pipelines/*",
    "engines/*",
    "workflows/*",
    "agents/*",
    "tools/*"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "lint": "./scripts/lint.sh",
    "test": "./scripts/test.sh",
    "build": "./scripts/build.sh",
    "release": "node ./scripts/release.mjs",
    "release:build": "node ./scripts/release.mjs build all",
    "release:activate": "node ./scripts/release.mjs activate enterprise",
    "start": "./scripts/start.sh",
    "start:gateway": "node ./tools/aol/bin/aol.mjs run -w @rtp/api-gateway start",
    "start:irs-gateway": "node ./tools/aol/bin/aol.mjs run -w @rtp/irs-gateway start",
    "start:ai-workforce": "node ./tools/aol/bin/aol.mjs run -w @rtp/ai-workforce-hub start",
    "start:refund-status": "node ./tools/aol/bin/aol.mjs run -w @rtp/refund-status-service start",
    "start:transcript": "node ./tools/aol/bin/aol.mjs run -w @rtp/transcript-service start",
    "start:analytics": "node ./tools/aol/bin/aol.mjs run -w @rtp/analytics-service start",
    "start:enrollment": "pnpm --filter @rtp/enrollment-service start",
    "start:invoice": "pnpm --filter @rtp/invoice-service start",
    "start:pos-crm": "pnpm --filter @rtp/pos-crm-service start",
    "start:security": "node ./services/security-status-service/src/index.mjs",
    "start:dashboard": "pnpm --filter @rtp/modules-dashboard start",
    "start:web-portal": "pnpm --filter @rtp/web-portal start",
    "start:staff-portal": "pnpm --filter @rtp/staff-portal start",
    "start:portal": "pnpm --filter @rtp/web-portal start",
    "start:workflows": "pnpm --filter @rtp/workflow-runner start",
    "security": "node ./scripts/security.mjs",
    "security:doctor": "node ./scripts/security.mjs doctor",
    "security:scan": "node ./scripts/security.mjs scan",
    "start:all": "./scripts/start-all.sh",
    "start:all:fg": "node ./scripts/start-all.mjs",
    "start:check": "node ./scripts/start-all.mjs --check-only",
    "deploy:all": "node scripts/deploy-all.mjs",
    "deploy:smoke": "node scripts/deploy-all.mjs --smoke",
    "deploy:full": "node scripts/deploy-platform.mjs",
    "deploy:full:smoke": "node scripts/deploy-platform.mjs --smoke",
    "deploy:full:quick": "node scripts/deploy-platform.mjs --smoke --skip-gates",
    "activate": "node packages/production-activation/bin/activate.mjs",
    "activate:status": "node packages/production-activation/bin/activate.mjs --status --json",
    "activate:heartbeat": "node packages/production-activation/bin/activate.mjs --heartbeat --json",
    "worker:tds": "node ./tools/aol/bin/aol.mjs run -w @rtp/tds-worker start -- --once",
    "worker:transcript-pull": "node ./tools/aol/bin/aol.mjs run -w @rtp/transcript-pull-worker start -- --once",
    "worker:live-source": "node ./tools/aol/bin/aol.mjs run -w @rtp/live-source-fetcher start -- --once",
    "worker:ai-persona": "node ./tools/aol/bin/aol.mjs run -w @rtp/ai-persona-worker start -- --once",
    "worker:security": "node ./workers/security-scanner-worker/src/index.mjs --once",
    "worker:workflows": "pnpm --filter @rtp/workflow-runner start --once",
    "workflow:list": "pnpm --filter @rtp/workflow-runner workflows",
    "workflow:run": "pnpm --filter @rtp/workflow-runner run-workflow",
    "agents": "node scripts/agents.mjs",
    "agents:docs": "node scripts/agents.mjs --write",
    "canvas": "node scripts/canvas.mjs",
    "canvas:create": "node scripts/canvas.mjs create all",
    "cloud:doctor": "node scripts/cloud-doctor.mjs",
    "clients": "node scripts/clients.mjs",
    "bench:aol": "node ./tools/aol/bin/aol.mjs bench",
    "aol": "node ./tools/aol/bin/aol.mjs",
    "team": "node ./packages/agent-build-team/bin/abet.mjs run",
    "team:inventory": "node ./packages/agent-build-team/bin/abet.mjs inventory",
    "team:roles": "node ./packages/agent-build-team/bin/abet.mjs roles",
    "team:plan": "node ./packages/agent-build-team/bin/abet.mjs plan",
    "rossco": "node ./tools/rossco/bin/rossco.mjs",
    "itr": "node ./tools/rossco/bin/rossco.mjs",
    "ross-infinite": "node ./tools/ross-infinite/bin/ross.mjs",
    "ross-infinite:test": "node --test tools/ross-infinite/tests/*.test.mjs",
    "ross-infinite:smoke": "bash ./tools/ross-infinite/scripts/smoke-test.sh",
    "ross-infinite:verify": "bash ./tools/ross-infinite/scripts/run-v1.sh",
    "seo:deploy": "bash ./scripts/seo-deploy-dns-tokens.sh",
    "ross": "python3 ./ross.py",
    "ross:init": "python3 ./ross.py init",
    "ross:doctor": "python3 ./ross.py doctor",
    "ross:dev": "python3 ./ross.py dev",
    "ross:package": "python3 ./ross.py package build",
    "ross:hello": "python3 ./ross.py runtime run hello",
    "compliance": "node ./packages/production-compliance/bin/prodcheck.mjs run",
    "compliance:checklist": "node ./packages/production-compliance/bin/prodcheck.mjs checklist",
    "compliance:report": "node ./packages/production-compliance/bin/prodcheck.mjs report",
    "compliance:log": "node ./packages/production-compliance/bin/prodcheck.mjs log"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
