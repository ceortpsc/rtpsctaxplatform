{
  "name": "RTPSC Enterprise Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "./scripts/aol install && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "start": "test -f assets/banners/primeweb-motd.txt && cat assets/banners/primeweb-motd.txt || true",
  "ports": [
    { "name": "api-gateway", "port": 3000 },
    { "name": "refund-status", "port": 3001 },
    { "name": "transcript", "port": 3002 },
    { "name": "analytics", "port": 3003 },
    { "name": "irs-gateway", "port": 8820 },
    { "name": "ai-workforce-hub", "port": 8860 }
  ],
  "terminals": [
    {
      "name": "api-gateway",
      "command": "./scripts/aol run start",
      "description": "Starts the RTPSC api-gateway on port 3000."
    },
    {
      "name": "ai-workforce-hub",
      "command": "./scripts/aol run start:ai-workforce",
      "description": "AI persona hire/pay hub UI on port 8860."
    }
  ]
}
