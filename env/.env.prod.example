APP_ENV=prod
NODE_ENV=production
SERVICE_PORT=3000
RTPSC_RELEASE_CHANNEL=stable
RTPSC_VERSION=2.0.0
API_CLIENT_ID=prod-api-client-id
API_CLIENT_SECRET=replace-in-approved-secret-store
TDS_CLIENT_ID=prod-tds-client-id
TDS_CLIENT_SECRET=replace-in-approved-secret-store
TUNNEL_CLIENT_ID=prod-tunnel-client-id
