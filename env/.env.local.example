APP_ENV=local
NODE_ENV=development
SERVICE_PORT=3000
# Full API + TDS client identities (issue with: ./rtpsc clients issue api|tds)
API_CLIENT_ID=
API_CLIENT_SECRET=
TDS_CLIENT_ID=
TDS_CLIENT_SECRET=
TUNNEL_CLIENT_ID=local-tunnel-client-id
TUNNEL_CLIENT_SECRET=replace-in-local-secret-store
APPROVED_TUNNEL_ENDPOINT=https://api.irs.gov/oauth2/v1/token
APPROVED_TUNNEL_ENDPOINT_SECONDARY=https://api.irs.gov/
TUNNEL_REQUIRE_HTTPS=true
# ERO / transmitter identity (optional local)
ERO_PTIN=
ERO_CAF_NUMBER=
EFIN=
ETIN=
EFILE_TRANSMISSION_ENABLED=false
# SBTPG operator credentials (never commit real values)
SBTPG_USERNAME=
SBTPG_SECRET=
SBTPG_ENABLED=false
IRS_TOKEN_URL=https://api.irs.gov/oauth2/v1/token
IRS_SCOPE=tds
IRS_CLIENT_ID=replace-via-cursor-or-secret-store
IRS_KEY_ID=replace-via-cursor-or-secret-store
IRS_PRIVATE_KEY_PATH=./certs/irs_tds_private.key
IRS_CLIENT_ID_PRIMARY=replace-via-cursor-or-secret-store
IRS_CLIENT_SECRET_PRIMARY=replace-via-cursor-or-secret-store
IRS_PRIVATE_KEY_PATH_PRIMARY=./certs/irs_tds_private.key
IRS_KEY_ID_PRIMARY=replace-via-cursor-or-secret-store
IRS_CLIENT_ID_SECONDARY=replace-via-cursor-or-secret-store
IRS_CLIENT_SECRET_SECONDARY=replace-via-cursor-or-secret-store
IRS_PRIVATE_KEY_PATH_SECONDARY=./certs/irs_tds_private_secondary.key
JWT_SECRET=replace-via-cursor-or-secret-store
SESSION_SECRET=replace-via-cursor-or-secret-store
ENCRYPTION_KEY=replace-via-cursor-or-secret-store
# Apple Developer / App Store Connect (never commit real .p8 contents)
APPLE_CONNECT_ENABLED=false
APPLE_ASC_ISSUER_ID=replace-via-cursor-or-secret-store
APPLE_ASC_KEY_ID=replace-via-cursor-or-secret-store
APPLE_ASC_PRIVATE_KEY_PATH=./certs/AuthKey_ASC.p8
# Optional inline PEM (prefer file path). Use \n for newlines if required.
APPLE_ASC_PRIVATE_KEY_PEM=
APPLE_TEAM_ID=replace-via-cursor-or-secret-store
APPLE_BUNDLE_ID=com.rosstaxsoftware.rtpsc
APPLE_ASC_TOKEN_TTL=1200
APPLE_RETURN_FULL_TOKEN=false
