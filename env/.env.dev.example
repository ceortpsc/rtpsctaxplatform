APP_ENV=dev
NODE_ENV=development
SERVICE_PORT=3000
RTPSC_RELEASE_CHANNEL=dev
RTPSC_VERSION=2.0.0
API_CLIENT_ID=dev-api-client-id
API_CLIENT_SECRET=replace-in-dev-secret-store
TDS_CLIENT_ID=dev-tds-client-id
